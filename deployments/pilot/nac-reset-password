#!/usr/bin/env bash
# Reset a NAC operator's password on the control node (root only).
# Use it when the password is forgotten; otherwise change it in the console
# (Account). The new password is read without echo and passed to nacd on
# stdin, never on the command line. Every session of the operator is signed
# out and the reset is written to the audit log.
#   sudo nac-reset-password admin@example.org
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "run as root (sudo nac-reset-password <email>)" >&2; exit 1; }
EMAIL=${1:?usage: nac-reset-password <operator-email>}
read -rsp "New password for $EMAIL (min 12 characters): " PW1; echo
read -rsp "Repeat: " PW2; echo
[ "$PW1" = "$PW2" ] || { echo "passwords differ; nothing changed" >&2; exit 1; }
printf '%s\n' "$PW1" | runuser -u nac -- bash -c 'set -a; . /etc/nac/nacd.env; exec /usr/local/bin/nacd -reset-password "$1"' _ "$EMAIL"
