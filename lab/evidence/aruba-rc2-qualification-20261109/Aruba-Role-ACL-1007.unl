<?xml version='1.0' encoding='utf-8'?>
<lab name="Aruba-Role-ACL-1007" id="8b04bdb6-c025-4729-9bbe-8a0005330152" version="1" scripttimeout="600" lock="0" author="NAC wired lab">
  <description>Aruba CX 10.07 per-session role/ACL compatibility experiment</description>
  <body>Isolated EVE data bridges. A single-NIC endpoint retains its address while the Aruba access session changes authorization. Third-party image provenance; platform capability results are separate from the rc10 NAC baseline.</body>
  <topology>
    <nodes>
      <node id="61" name="ArubaCX-10.07-access" type="qemu" template="arubacx" image="arubacx-10.07" console="telnet" cpu="2" cpulimit="1" ram="4096" ethernet="7" uuid="38ec6273-08ed-4627-8587-d2203bc6878b" qemu_options="-machine type=pc-1.0,accel=kvm -serial mon:stdio -nographic -no-user-config -nodefaults -rtc base=utc" qemu_version="5.2.0" qemu_arch="x86_64" delay="0" icon="Router.png" config="0" left="420" top="250" qemu_nic="virtio-net-pci">
        <interface id="0" name="mgmt" type="ethernet" network_id="64" />
        <interface id="1" name="1/1/1" type="ethernet" network_id="61" />
        <interface id="2" name="1/1/2" type="ethernet" network_id="62" />
        <interface id="3" name="1/1/3" type="ethernet" network_id="65" />
        <interface id="4" name="1/1/4" type="ethernet" network_id="63" />
      </node>
      <node id="62" name="Aruba-DHCP-endpoint" type="qemu" template="linux" image="linux-nac-dhcp-endpoint" console="telnet" cpu="1" cpulimit="1" ram="768" ethernet="1" uuid="d4935bcf-dfcc-4bdb-925d-846a7a547bf9" firstmac="00:50:00:00:3e:00" qemu_options="-machine type=pc,accel=kvm -serial mon:stdio -nographic -display none -no-user-config -rtc base=utc -boot order=c -cpu host" qemu_version="8.2.1" qemu_arch="x86_64" qemu_nic="virtio-net-pci" delay="0" icon="Router.png" config="0" left="120" top="250">
        <interface id="0" name="e0" type="ethernet" network_id="61" />
      </node>
      <node id="63" name="Aruba-corp-service" type="qemu" template="linux" image="linux-nac-dhcp-corp" console="telnet" cpu="1" cpulimit="1" ram="768" ethernet="1" uuid="731f39c9-1a99-489f-8ff8-8e06301d0563" firstmac="00:50:00:00:3f:00" qemu_options="-machine type=pc,accel=kvm -serial mon:stdio -nographic -display none -no-user-config -rtc base=utc -boot order=c -cpu host" qemu_version="8.2.1" qemu_arch="x86_64" qemu_nic="virtio-net-pci" delay="0" icon="Router.png" config="0" left="760" top="140">
        <interface id="0" name="e0" type="ethernet" network_id="62" />
      </node>
      <node id="64" name="Aruba-remediation-service" type="qemu" template="linux" image="linux-nac-dhcp-quarantine" console="telnet" cpu="1" cpulimit="1" ram="768" ethernet="1" uuid="9f7b6c10-d11f-434c-bc73-e0d7c85a6052" firstmac="00:50:00:00:40:00" qemu_options="-machine type=pc,accel=kvm -serial mon:stdio -nographic -display none -no-user-config -rtc base=utc -boot order=c -cpu host" qemu_version="8.2.1" qemu_arch="x86_64" qemu_nic="virtio-net-pci" delay="0" icon="Router.png" config="0" left="760" top="380">
        <interface id="0" name="e0" type="ethernet" network_id="63" />
      </node>
      <node id="65" name="Aruba-FreeRADIUS-control" type="qemu" template="linux" image="linux-nac-control" console="telnet" cpu="2" cpulimit="1" ram="2048" ethernet="1" uuid="90e60c19-fcf3-4f8d-834a-31119b4f5e10" firstmac="00:50:00:00:41:00" qemu_options="-machine type=pc,accel=kvm -serial mon:stdio -nographic -display none -no-user-config -rtc base=utc -boot order=c -cpu host" qemu_version="8.2.1" qemu_arch="x86_64" qemu_nic="virtio-net-pci" delay="0" icon="Router.png" config="0" left="120" top="510">
        <interface id="0" name="e0" type="ethernet" network_id="64" />
      </node>
      <node id="66" name="Aruba-same-subnet-peer" type="qemu" template="linux" image="linux-nac-dhcp-corp" console="telnet" cpu="1" cpulimit="1" ram="768" ethernet="1" uuid="9e4b10a2-78de-41d6-b5a7-e1783e947381" firstmac="00:50:00:00:42:00" qemu_options="-machine type=pc,accel=kvm -serial mon:stdio -nographic -display none -no-user-config -rtc base=utc -boot order=c -cpu host" qemu_version="8.2.1" qemu_arch="x86_64" qemu_nic="virtio-net-pci" delay="0" icon="Router.png" config="0" left="760" top="270">
        <interface id="0" name="e0" type="ethernet" network_id="65" />
      </node>
    </nodes>
    <networks>
      <network id="61" type="bridge" name="aruba-access-link" left="307" top="268" visibility="1" icon="lan.png" />
      <network id="62" type="bridge" name="aruba-corp-link" left="614" top="153" visibility="1" icon="lan.png" />
      <network id="63" type="bridge" name="aruba-remediation-link" left="614" top="384" visibility="1" icon="lan.png" />
      <network id="64" type="bridge" name="aruba-control-link" left="307" top="499" visibility="1" icon="lan.png" />
      <network id="65" type="bridge" name="aruba-peer-link" left="614" top="270" visibility="1" icon="lan.png" />
    </networks>
  </topology>
</lab>