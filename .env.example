# Example environment configuration for nacd.
# Copy to `.env` for local use. DO NOT commit a real .env.
# All variables are read at startup; see docs/operations/configuration.md.

# Deployment environment: development | staging | production
NAC_ENV=development

# HTTP server
NAC_HTTP_ADDR=:8080
NAC_HTTP_READ_TIMEOUT=10s
NAC_HTTP_WRITE_TIMEOUT=15s
NAC_HTTP_SHUTDOWN_TIMEOUT=20s
NAC_HTTP_MAX_BODY_BYTES=1048576
NAC_HTTP_RATE_LIMIT_PER_MIN=600

# PostgreSQL (required)
NAC_DB_DSN=postgres://nac:nac@localhost:5432/nac?sslmode=disable
NAC_DB_MAX_CONNS=10
NAC_DB_MIN_CONNS=2

# Redis (optional; empty disables policy caching)
NAC_REDIS_ADDR=localhost:6379
NAC_REDIS_PASSWORD=
NAC_REDIS_DB=0
NAC_REDIS_TTL=30s

# Authentication secrets (REQUIRED and must be strong outside development)
# Generate with: openssl rand -base64 48
NAC_JWT_SIGNING_KEY=replace-with-a-32+byte-random-secret-please
NAC_JWT_ISSUER=nac
NAC_JWT_AUDIENCE=nac-api
NAC_JWT_TTL=1h

# Service token for network enforcement points calling /access/evaluate
# Generate with: openssl rand -hex 32
NAC_SERVICE_TOKEN=replace-with-a-24+char-random-token

# Access engine default action when no policy matches: deny | quarantine | allow
# Secure default is "deny". Changing this weakens least-privilege.
NAC_DEFAULT_ACTION=deny

# Logging
NAC_LOG_LEVEL=info
NAC_LOG_FORMAT=json

# First-boot admin bootstrap (optional; idempotent)
NAC_BOOTSTRAP_ADMIN_EMAIL=admin@nac.local
NAC_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
